# Render Environment Variables Template for Frontend
# Copy this file to .env.local and fill in your actual values

# Backend API URL (replace with your actual Render backend URL)
NEXT_PUBLIC_API_URL=https://alerted-backend.onrender.com

# Cloudflare R2 Public URL (replace with your actual R2 bucket URL)
NEXT_PUBLIC_R2_URL=https://alerted-storage.r2.cloudflarestorage.com