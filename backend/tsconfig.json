{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "src/testRelationships.ts",
    "src/testReportGeneration.ts",
    "src/testReportGenerationAllTypes.ts",
    "src/utils/testConnection.ts",
    "src/utils/testDNS.ts",
    "src/clearAttendance.ts",
    "src/clearExistingData.ts",
    "src/recalculateRiskScores.ts",
    "src/seedAttendanceForAllTerms.ts",
    "src/seedHighRiskStudents.ts",
    "src/seedInterconnectedData.ts",
    "src/seedSchedules.ts",
    "src/seedStudentIds.ts",
    "src/seedUsers.ts",
    "src/utils/seed.ts",
    "src/utils/seedHistoricalData.ts"
  ]
}
