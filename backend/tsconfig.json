{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "src/testRelationships.ts",
    "src/testReportGeneration.ts",
    "src/testReportGenerationAllTypes.ts",
    "src/utils/testConnection.ts",
    "src/utils/testDNS.ts",
    "src/clearAttendance.ts",
    "src/clearExistingData.ts",
    "src/recalculateRiskScores.ts",
    "src/seedAttendanceForAllTerms.ts",
    "src/seedHighRiskStudents.ts",
    "src/seedInterconnectedData.ts",
    "src/seedSchedules.ts",
    "src/seedStudentIds.ts",
    "src/seedUsers.ts",
    "src/utils/seed.ts",
    "src/utils/seedHistoricalData.ts"
  ]
}
